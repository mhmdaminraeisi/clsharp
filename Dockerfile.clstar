# syntax=docker/dockerfile:1
FROM gradle:8.5-jdk21 AS gradle
FROM eclipse-temurin:21-jdk-jammy AS java-builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates cmake g++ git make \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/nclsharp
COPY --from=gradle /opt/gradle/ /opt/gradle/
COPY build.gradle settings.gradle ./
COPY src/ src/
COPY baseline/clstar/src/ baseline/clstar/src/
COPY docker/build-java.sh /usr/local/bin/build-java
# Keep aligned with the hybrid-ads submodule commit.
ARG HYBRID_ADS_REV=f23946f00c1c111c9b061b6f43d1ffe8b32582bd
RUN --mount=type=cache,target=/root/.gradle,sharing=locked sh /usr/local/bin/build-java

FROM eclipse-temurin:21-jre-jammy AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/nclsharp
COPY --from=java-builder /opt/nclsharp/build/install/nclsharp/lib/ ./lib/
COPY --from=java-builder /opt/nclsharp/build/clstar/lib/ ./clstar/lib/
COPY --from=java-builder /opt/nclsharp/build-source.sha256 ./build-source.sha256
COPY --from=java-builder /opt/nclsharp/hybrid-ads/build/main ./hybrid-ads/build/main
COPY --from=java-builder /opt/nclsharp/hybrid-ads/LICENSE ./hybrid-ads/LICENSE
COPY baseline/clstar/README.md baseline/clstar/NOTICE.md baseline/clstar/imported-sources.sha256 ./baseline/clstar/
COPY LICENSE ./LICENSE
COPY src/main/resources/ ./src/main/resources/
COPY benchmarks/ ./benchmarks/
COPY docker/run-benchmark.sh /usr/local/bin/run-benchmark
ENV HYBRID_ADS_REVISION=f23946f00c1c111c9b061b6f43d1ffe8b32582bd
ENV BENCHMARK_MODELS=benchmarks/paper-models.txt \
    BENCHMARK_ALGORITHMS=clstar-cached,clstar-no-cache \
    BENCHMARK_OUTPUT=/results/clstar
ENTRYPOINT ["sh", "/usr/local/bin/run-benchmark"]
