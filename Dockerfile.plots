# syntax=docker/dockerfile:1
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

ENV MPLBACKEND=Agg \
    MPLCONFIGDIR=/tmp/matplotlib \
    PYTHONDONTWRITEBYTECODE=1
COPY plot/requirements.txt /opt/plots/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --disable-pip-version-check --timeout 120 --retries 5 -r /opt/plots/requirements.txt
COPY plot/plot_results.py /opt/plots/plot_results.py
COPY LICENSE /opt/plots/LICENSE
WORKDIR /data
ENTRYPOINT ["python", "/opt/plots/plot_results.py", "--output-dir", "/data/figures"]
